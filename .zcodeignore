# --- Java / Maven ---
target/
*.class
*.jar
!.mvn/wrapper/*.jar
.mvn/timing.properties
hs_err_pid*

# --- Node / Yarn ---
node_modules/
.yarn/*!
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
dist/
coverage/
*.tsbuildinfo

# --- Runtime data (local database, blob store, generated keys, logs) ---
data/
tmp/
logs/
*.log

# --- IDE ---
.idea/
*.iml
.vscode/
.DS_Store

# --- Local env ---
.env
.env.local

# Local deploy-script configuration (may hold the Cloudflare API token)
deploy.conf

# Host-local monitor release image selection
.monitor-release.yml
docker-compose.monitor-build.override.yml

# ZCode CLI local session state
.zcode/
__pycache__/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
venv/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
