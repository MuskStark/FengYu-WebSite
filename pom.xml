<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        FengYu-WebSite — parent POM.

        Independent version line from the FengYu host application and the plugin
        toolchain (design §5.1 / ADR-001). Versions for the whole Spring stack are
        managed exclusively by the Spring Boot 4.1.x BOM (design §5.2); business
        modules must not declare their own Spring-family versions.
    -->
    <groupId>dev.infinia.store</groupId>
    <artifactId>infinia-store-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>FengYu-WebSite</name>
    <description>Cloud control plane for the Infinia / FengYu ecosystem: catalog, publishing,
        review, signed delivery and accounts for APP, PLUGIN, SKILL, MCP and FLOW artifacts.</description>
    <url>https://github.com/MuskStark/FengYu-WebSite</url>

    <licenses>
        <license>
            <name>GNU General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>store-contract</module>
        <module>store-domain</module>
        <module>store-infrastructure</module>
        <module>store-scanner</module>
        <module>store-application</module>
        <module>store-monitor</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Single maintenance line: Spring Boot 4.1.x, always latest security patch. -->
        <spring-boot.version>4.1.1</spring-boot.version>

        <!-- S3-compatible artifact storage (MinIO in compose, any SigV4 endpoint). -->
        <aws-sdk.version>2.54.13</aws-sdk.version>

        <!-- Smart-HTTP serving of the exported ecosystem git repos (audit 3.4).
             Independent line from the Spring BOM; 7.x is the current Jakarta
             Servlet (Boot 4 / Tomcat 11) generation of JGit. -->
        <jgit.version>7.7.1.202607240634-r</jgit.version>

        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- AWS SDK v2 is outside the Boot BOM; every S3 artifact version comes
                 from this import so modules never pin their own. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- JGit smart-HTTP server (outside the Boot BOM); the core bundle
                 arrives transitively with matching version. -->
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit.http.server</artifactId>
                <version>${jgit.version}</version>
            </dependency>
            <!-- Reactor-internal modules -->
            <dependency>
                <groupId>dev.infinia.store</groupId>
                <artifactId>store-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.infinia.store</groupId>
                <artifactId>store-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.infinia.store</groupId>
                <artifactId>store-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.infinia.store</groupId>
                <artifactId>store-scanner</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.infinia.store</groupId>
                <artifactId>store-monitor</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Every module may use JUnit; versions come from the Boot BOM. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <argLine>-Xshare:off -Dfile.encoding=UTF-8</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
