# Example environment for `docker compose` (copy to .env and fill in).
# The three STORE_*_SECRET values below are enforced at compose parse time
# (mandatory-variable syntax), so every compose command needs this file with
# them filled in — and ProductionHardeningCheck re-verifies them at store boot.
#
# Generate secrets:  openssl rand -hex 32

# --- Store (application plane, required) -------------------------------------
# ProductionHardeningCheck aborts store startup when these are missing.
STORE_TICKET_SECRET=change-me-openssl-rand-hex-32
STORE_ROLLOUT_SECRET=change-me-openssl-rand-hex-32
STORE_CLI_CLIENT_SECRET=change-me-openssl-rand-hex-32

# The store's PUBLIC address as browsers reach it (through the reverse
# proxy / WAF). Absolute URLs and OAuth redirects derive from it.
#STORE_BASE_URL=https://store.example.com

# Absolute origin baked into the SPA for its hashed /assets/** files when they
# are published to Cloudflare Pages (first-visit 522 fix — see DEPLOYMENT.md
# "Static assets on Cloudflare Pages"). Empty (default) keeps assets
# same-origin and existing deployments unchanged. When set it MUST equal the
# repo variable of the same name used by CI's asset publish: a different value
# changes bundle hashes and the shell would reference files Pages never got.
#ASSETS_BASE_URL=https://assets.example.com/
# (On the monitor host's own .env the same key names the monitor's assets
# origin, e.g. https://status-assets.example.com/ — see deploy-assets.sh
# --monitor.)

# Maven mirror used INSIDE the store/monitor image builds (dependency
# pre-fetch crawls on slow links to Maven Central). Empty keeps Maven
# Central; hosts in China typically want the Aliyun mirror.
#MAVEN_MIRROR=https://maven.aliyun.com/repository/public

# npm/Yarn mirror used INSIDE the store image build — Corepack downloads the
# Yarn CLI from repo.yarnpkg.com and `yarn install` resolves packages from
# registry.npmjs.org, both unreachable from some networks (a changed
# yarn.lock invalidates that cached layer, so a deploy that used to hit the
# cache suddenly needs them). docker-compose defaults to npmmirror, so a bare
# host needs no .env entry; opt out (overseas hosts, or a reachable direct
# registry) with an explicit empty value:
#NPM_MIRROR=

# --- Upstream aggregation (optional) -----------------------------------------
# Default SkillHub mirror registered on first boot; the sync publishes through
# internal credential-less machine accounts it provisions itself. Set enabled
# to false if this deployment should not aggregate external catalogs.
#STORE_UPSTREAM_DEFAULTS_ENABLED=true
#STORE_UPSTREAM_SKILLHUB_URL=https://api.skillhub.cn/api/skills?pages=1

# --- Membership purchase gateways (optional) ----------------------------------
# PaymentGatewayConfig picks the FIRST configured one (bmac → epay → xunhu);
# unset everywhere = the purchase page reports payment_not_configured and
# nothing else changes.
#
# Buy Me a Coffee (recommended default — free to start, BMAC keeps 5%):
#   1. Create priced Extras on your BMC page, one per membership plan.
#   2. Paste each Extra's share link into the plan's 外部收款链接 field
#      (Admin console → 会员套餐) and price the plan in your BMC currency's
#      cents (e.g. $3 → 300). Payments match back by supporter email + amount,
#      so buyers must pay with their store account email.
#   3. BMC dashboard → Integrations → Webhooks: endpoint
#      https://<store>/api/v1/payments/bmac/notify, subscribe to the donation
#      and extra_purchase events, copy the Signing Secret below.
#STORE_PAY_BMAC_PAGE_URL=https://buymeacoffee.com/yourname
#STORE_PAY_BMAC_WEBHOOK_SECRET=
# How long a pending order stays matchable to an incoming payment (minutes):
#STORE_PAY_BMAC_MATCH_WINDOW_MINUTES=1440
#
# Epay protocol (易支付协议 — self-hosted V免付 / 彩虹易支付; zero fees, needs
# your own instance + phone-side monitor app; personal QR codes carry ToS risk):
#STORE_PAY_EPAY_API_BASE=
#STORE_PAY_EPAY_PID=
#STORE_PAY_EPAY_KEY=
#
# XunHuPay (虎皮椒 — WeChat/Alipay for individuals; the platform charges an
# account-opening fee; WeChat and Alipay are separate apps there):
#STORE_PAY_XUNHU_API_BASE=https://api.xunhupay.com
#STORE_PAY_XUNHU_WECHAT_APPID=
#STORE_PAY_XUNHU_WECHAT_APPSECRET=
#STORE_PAY_XUNHU_ALIPAY_APPID=
#STORE_PAY_XUNHU_ALIPAY_APPSECRET=
# Minutes before an unpaid order closes (default 30):
#STORE_PAY_ORDER_EXPIRE_MINUTES=30

# --- Monitor (application plane) ---------------------------------------------
# Store host (co-located monitor, --profile monitor): probe through the
# proxy/WAF to measure true external reachability; default inside the compose
# network is http://store:8080.
# Monitor host (docker-compose.monitor.yml): MONITOR_TARGET_BASE_URL is
# REQUIRED — the store's URL as this host reaches it.
# The store SPA's /status link redirects to STORE_MONITOR_PUBLIC_URL at
# runtime — set it to the address browsers should open, e.g.
# https://status.example.com (or http://<monitor-host>:8090 direct).
#MONITOR_TARGET_BASE_URL=https://store.example.com
#STORE_MONITOR_PUBLIC_URL=https://status.example.com
#MONITOR_ALERT_WEBHOOK=
#MONITOR_IMAGE_TAG=latest
# GHCR proxy for networks without direct ghcr.io access (monitor host only):
#MONITOR_IMAGE_REGISTRY=ghcr.m.daocloud.io
#
# Real-time probing & the SSE stream (all optional; defaults shown). Probes
# and the mirror fetch each run every 5 s so a confirmed fault reaches the
# page within ~15 s; 2 consecutive failures confirm a fault, 2 successes
# confirm recovery. Legacy MONITOR_POLL_INTERVAL_MS still steers probing.
#MONITOR_PROBE_INTERVAL_MS=5000
#MONITOR_MIRROR_INTERVAL_MS=5000
#MONITOR_PROBE_TIMEOUT_MS=8000
#MONITOR_MIRROR_TIMEOUT_MS=8000
#MONITOR_CONFIRM_FAILURE_THRESHOLD=2
#MONITOR_CONFIRM_RECOVERY_THRESHOLD=2
#MONITOR_OBSERVATION_VALIDITY_MS=180000
#MONITOR_SSE_MAX_CONNECTIONS=200
#MONITOR_SSE_HEARTBEAT_MS=15000
#MONITOR_SSE_REPLAY_CAPACITY=1000

# --- Store status sampling (optional) -----------------------------------------
# Tiered in-process sampling (defaults shown): core services (liveness +
# database) every 5 s, resource metrics every 30 s; 2 consecutive failures
# confirm a fault, 2 successes confirm recovery. Only relevant when you need
# to slow probing down (e.g. constrained databases).
#STORE_STATUS_CORE_INTERVAL_MS=5000
#STORE_STATUS_METRICS_INTERVAL_MS=30000
#STORE_STATUS_CONFIRM_FAILURE=2
#STORE_STATUS_CONFIRM_RECOVERY=2
#STORE_STATUS_OBSERVATION_VALIDITY_MS=180000

# --- Dependency-plane credentials --------------------------------------------
# Dev defaults below are only safe while ports stay loopback-bound.
#POSTGRES_DB=store
#POSTGRES_USER=store
#POSTGRES_PASSWORD=change-me
#MINIO_ROOT_USER=store
#MINIO_ROOT_PASSWORD=change-me

# --- Publishing (optional) ----------------------------------------------------
# The app ports (8080/8090) publish on all interfaces by default — a WAF on
# another host or LAN clients reach them directly. Set 127.0.0.1 to restrict
# to loopback when the reverse proxy is co-located; to limit an open port to
# the WAF's IP use the DOCKER-USER iptables chain — plain ufw does NOT filter
# Docker-published ports (see DEPLOYMENT.md "WAF on a separate host").
#STORE_BIND_HOST=127.0.0.1
#MONITOR_BIND_HOST=127.0.0.1

# --- Container sizing (all services, optional) -------------------------------
#DOCKER_CPUS_LIMIT=2
#DOCKER_MEM_LIMIT=1g
